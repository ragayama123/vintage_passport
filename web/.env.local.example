# === VINTAGE PASSPORT 環境変数 ===
# このファイルをコピーして web/.env.local を作り、値を埋めること。
# .env* はコミットされない（.gitignore 済み）。秘密鍵・APIキーは絶対にコミットしない。

# --- AI鑑定 (Claude API / Vision) ---
# console.anthropic.com でキー発行
ANTHROPIC_API_KEY=

# --- IPFS (Pinata) ---
# app.pinata.cloud 無料アカウント → API Key(pinning権限付き) → JWT
PINATA_JWT=

# --- HashKey Chain testnet ---
# 公式値。ハードコード前に chainId=133 の実接続を確認済み。
HASHKEY_TESTNET_RPC_URL=https://testnet.hsk.xyz
CHAIN_ID=133

# testnet専用ウォレットの秘密鍵(0x付き)。カストディアル署名に使う。
# 絶対に mainnet 資産の入ったウォレットを使わないこと。
# faucet: https://faucet.hsk.xyz/faucet でこのアドレスに HSK(ガス代)を取得
CUSTODIAL_PRIVATE_KEY=

# コントラクトデプロイ後に設定（deploy スクリプトが両方の値を表示する）
CONTRACT_ADDRESS=
# デプロイ時のブロック番号。所有履歴(eth_getLogs)の走査開始に使う。
# 未設定だと block 0 から走査し、公開RPCに拒否されることがある。
DEPLOY_BLOCK=

# --- クライアント公開 (NEXT_PUBLIC_) ---
NEXT_PUBLIC_EXPLORER_BASE_URL=https://testnet-explorer.hsk.xyz
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# 検証ページQRの絶対URL生成に使う(デプロイ先URL)。ローカルは http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
